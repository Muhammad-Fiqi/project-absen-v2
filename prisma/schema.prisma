// PTE Attendance System — Simplified Schema
// Database: SQLite (local dev) or Turso Cloud (via @prisma/adapter-libsql)
// Local dev: DATABASE_URL=file:db/custom.db
// Production:  DATABASE_URL=libsql://your-db.turso.io + DATABASE_AUTH_TOKEN=...
//
// BUSINESS MODEL:
// - A course has sessions. Each session has a max attendee limit (default 10).
// - Attendance via QR scan only.
// - Each student has a personal session quota.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===================== Admin / Teacher =====================
model AdminUser {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("teacher") // "admin" | "teacher"
  createdAt    DateTime @default(now())
  sessions     Session[]
  quotaExts    QuotaExtension[]
  extRequests  ExtensionRequest[] @relation("ReviewedExtensionRequests")
}

// ===================== Course =====================
model Course {
  id                  String    @id @default(cuid())
  code                String    @unique // e.g. "PTE-2024-A"
  name                String
  description         String?
  defaultQuota        Int       @default(15)
  totalSessions       Int       @default(20) // reference target (informational)
  graceMinutesBefore  Int       @default(10)
  graceMinutesAfter   Int       @default(20)
  createdAt           DateTime  @default(now())
  sessions            Session[]
  students            Student[]
}

// ===================== Student =====================
model Student {
  id                String   @id @default(cuid())
  studentCode       String   @unique // e.g. "PTE001"
  name              String
  email             String?
  phone             String?
  courseCode        String
  courseId          String?
  course            Course?  @relation(fields: [courseId], references: [id])
  pinHash           String?  // personal PIN for login
  // Quota system
  sessionQuota      Int      @default(15)
  quotaExtendedAt   DateTime?
  quotaNote         String?
  createdAt         DateTime @default(now())
  attendances       Attendance[]
  quotaExtensions   QuotaExtension[]
  extensionRequests ExtensionRequest[]
}

// ===================== Session =====================
model Session {
  id             String   @id @default(cuid())
  courseId       String
  course         Course   @relation(fields: [courseId], references: [id])
  sessionNumber  Int      // display order (SESI 1, 2, 3...)
  title          String   // e.g. "SESI 1"
  date           DateTime // the calendar day
  startTime      DateTime
  endTime        DateTime
  mode           String   @default("offline") // "offline" | "online"
  platform       String?  // "Office" | "Google Meet" | etc.
  room           String?  // room name or meeting link
  teacher        String?  // teacher name e.g. "Mr Dimas"
  topicOfDay     String?  // shared material for the day
  maxAttendees   Int      @default(10) // max students per session
  status         String   @default("scheduled") // scheduled | active | completed | cancelled
  qrSecret       String   // secret used to sign rotating QR tokens
  notes          String?
  createdById    String?
  createdBy      AdminUser? @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  attendances    Attendance[]
  qrTokens       QrToken[]

  @@index([courseId, date])
  @@index([date])
  @@index([status])
}

// ===================== Attendance =====================
model Attendance {
  id            String   @id @default(cuid())
  sessionId     String
  session       Session  @relation(fields: [sessionId], references: [id])
  studentId     String
  student       Student  @relation(fields: [studentId], references: [id])
  status        String   @default("present") // present | late | absent | excused
  checkInTime   DateTime @default(now())
  // Day key (YYYY-MM-DD) — one session per day rule
  dayKey        String
  qrVerified    Boolean  @default(false)
  verified      Boolean  @default(false)
  notes         String?
  createdAt     DateTime @default(now())

  @@unique([sessionId, studentId])
  @@index([studentId, dayKey])
}

// ===================== QR Token (rotating) =====================
model QrToken {
  id         String   @id @default(cuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id])
  token      String   @unique
  hmac       String
  issuedAt   DateTime @default(now())
  expiresAt  DateTime
  used       Boolean  @default(false)

  @@index([sessionId, expiresAt])
}

// ===================== Quota Extension (audit log) =====================
model QuotaExtension {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  adminId     String?
  admin       AdminUser? @relation(fields: [adminId], references: [id])
  oldQuota    Int
  newQuota    Int
  addedSessions Int
  reason      String?
  createdAt   DateTime @default(now())

  @@index([studentId])
}

// ===================== Extension Request (student → teacher) =====================
model ExtensionRequest {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id])
  requestedSessions Int
  reason      String
  status      String   @default("pending") // pending | approved | denied
  reviewedById String?
  reviewedBy  AdminUser? @relation("ReviewedExtensionRequests", fields: [reviewedById], references: [id])
  reviewedAt  DateTime?
  reviewNote  String?
  createdAt   DateTime @default(now())

  @@index([studentId])
  @@index([status])
}