# ============ PTE Attendance System ============

# --- DATABASE (pilih salah satu) ---

# Opsi 1: Local SQLite (untuk development / VPS)
DATABASE_URL=file:db/custom.db

# Opsi 2: Turso Cloud (untuk Vercel / serverless deployment)
# DATABASE_URL=libsql://pte-attendance-yourname.turso.io
# DATABASE_AUTH_TOKEN=your-turso-auth-token

# --- AUTH ---
AUTH_SECRET=change-this-to-a-random-secret-string

# --- Optional: Selfie VLM (z-ai-web-dev-sdk) ---
# ZAI_API_KEY=your-api-key